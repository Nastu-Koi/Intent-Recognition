__pycache__
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 测试和覆盖率
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.hypothesis/

# 环境变量（不上传真实的 .env）
.env
.env.local
.env.*.local

# 日志
*.log
logs/

# 其他
.DS_Store
.AppleDouble
.LSOverride
*.pem
*.key
node_modules/
